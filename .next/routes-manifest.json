{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/national-teams",
      "regex": "^/national\\-teams(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/national\\-teams(?:/)?$"
    },
    {
      "page": "/pro-leagues",
      "regex": "^/pro\\-leagues(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pro\\-leagues(?:/)?$"
    },
    {
      "page": "/provincial-leagues",
      "regex": "^/provincial\\-leagues(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/provincial\\-leagues(?:/)?$"
    },
    {
      "page": "/stats",
      "regex": "^/stats(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/stats(?:/)?$"
    },
    {
      "page": "/the-wire",
      "regex": "^/the\\-wire(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/the\\-wire(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}