# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real keys.

# Sanity (public — these are safe to expose, Sanity reads are public by design)
NEXT_PUBLIC_SANITY_PROJECT_ID="uvf97j3d"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-01"

# Supabase (public — anon key only, Row Level Security controls what it can read)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase service role key — SECRET, full read/write, bypasses Row Level
# Security. Only ever used locally for one-off scripts like
# scripts/import-cpl-data.mjs, passed as an inline env var when you run
# them — never put this one in .env.local, never in NEXT_PUBLIC_*, never
# in the deployed app.
#   SUPABASE_SERVICE_ROLE_KEY="..." node scripts/import-cpl-data.mjs
