{
  "name": "maple-pitch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --no-lint && npx @opennextjs/cloudflare build --skip-build",
    "start": "next start",
    "lint": "eslint .",
    "cf:build": "next build && npx @opennextjs/cloudflare build --skip-build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:data": "node scripts/validate-data.mjs",
    "import:cpl": "node scripts/import-cpl-data.mjs",
    "import:national-teams": "node scripts/import-canadian-national-teams.mjs",
    "check": "rm -rf .open-next .next && npm run lint && npm run typecheck && npm run test:data && npm run build",
    "check:local": "npm run typecheck && npm run test:data"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.460.0",
    "next": "^15.4.0",
    "next-sanity": "^12.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
